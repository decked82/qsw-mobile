rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /movements/{movementId} {
      allow read, write: if true;
    }

    match /inbound_transactions/{transactionId} {
      allow read, write: if true;
    }

    match /box_sequences/{dateKey} {
      allow read, write: if true;
    }
  }
}
